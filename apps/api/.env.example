# Database & Cache
DATABASE_URL="postgresql://geminihub:geminihub_secret_2026@localhost:5432/geminihub_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Server Port & Host
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# Security & Cryptography (32 bytes hex for AES-256-GCM)
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super-secret-jwt-key-change-in-production-2026"
COOKIE_SECRET="super-secret-cookie-key-change-in-production-2026"

# Frontend Web Origin for CORS
WEB_ORIGIN="http://localhost:3000"

# Telegram Admin Notification Bot (Optional in dev)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# SePay Webhook API Key
SEPAY_API_KEY="sepay_secret_token_123"

# Allow Live Buy Switch (Must be "true" to enable real calls to bot sources)
ALLOW_LIVE_BUY="false"

